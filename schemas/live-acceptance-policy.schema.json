{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/blob/main/schemas/live-acceptance-policy.schema.json",
  "title": "Live acceptance receipt policy",
  "description": "Required operation coverage, receipt directories, freshness, and scheduled re-evaluation for committed live-acceptance receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxReceiptAgeDays",
    "requiredOperations",
    "receiptDirectories",
    "historicalDirectory",
    "scheduledCheck",
    "rerunProcedure"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0"},
    "maxReceiptAgeDays": {"type": "integer", "minimum": 1},
    "requiredOperations": {
      "description": "Nonempty operation coverage enforced in targeted and aggregate mode; each key must have an implemented receipt validator.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/requiredOperation"}
    },
    "receiptDirectories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "historicalDirectory": {"$ref": "#/$defs/relativePath"},
    "scheduledCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "cron"],
      "properties": {
        "workflow": {
          "$ref": "#/$defs/relativePath",
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.yml$"
        },
        "cron": {"type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$"}
      }
    },
    "rerunProcedure": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "$defs": {
    "requiredOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operation", "action"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "operation": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "action": {"enum": ["APPLIED", "NO_OP", null]}
      }
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
    }
  }
}
