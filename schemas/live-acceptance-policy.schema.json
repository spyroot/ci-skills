{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/blob/main/schemas/live-acceptance-policy.schema.json",
  "title": "Live acceptance receipt policy",
  "description": "Receipt directories, freshness window, and scheduled re-evaluation for committed live-acceptance receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxReceiptAgeDays",
    "receiptDirectories",
    "historicalDirectory",
    "scheduledCheck",
    "rerunProcedure"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0"},
    "maxReceiptAgeDays": {"type": "integer", "minimum": 1},
    "receiptDirectories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "historicalDirectory": {"$ref": "#/$defs/relativePath"},
    "scheduledCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "cron"],
      "properties": {
        "workflow": {
          "$ref": "#/$defs/relativePath",
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.yml$"
        },
        "cron": {"type": "string", "pattern": "^\\S+ \\S+ \\S+ \\S+ \\S+$"}
      }
    },
    "rerunProcedure": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "not": {"pattern": "(^|/)\\.\\.?(/|$)"}
    }
  }
}
