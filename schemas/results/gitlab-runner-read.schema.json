{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/results/gitlab-runner-read.schema.json",
  "title": "GitLab runner get or list result",
  "description": "A bounded live relation from a selected job or scope to public runner state.",
  "type": "object",
  "required": ["schema_version","kind","status","captured_at","errors","summary"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "kind": {"const":"gitlab_runner"},
    "status": {"enum":["DRY_RUN","PASS","BLOCKED"]},
    "captured_at": {"type":"string","format":"date-time"},
    "execution_host": {"type":"string","minLength":1},
    "tested_revision": {"type":["string","null"]},
    "origin": {"type":"string","pattern":"^https://"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","reference"],
      "properties": {"kind":{"enum":["project","group"]},"reference":{"type":"string","minLength":1}}
    },
    "target_file": {"type":"string","minLength":1},
    "target_source": {"type":"string","minLength":1},
    "operation": {"enum":["get","list"]},
    "phase": {"enum":["OFFLINE_PLAN","ACCESS","READ"]},
    "mutated": {"const":false},
    "plan_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "target_kind",
        "target_reference",
        "resource_id",
        "project_ids",
        "confirmation_ready",
        "fields",
        "body_sha256",
        "plan_digest",
        "one_time_sink_required"
      ],
      "properties": {
        "operation": {"enum":["get","list"]},
        "target_kind": {"enum":["project","group"]},
        "target_reference": {"type":"string","minLength":1},
        "resource_id": {"type":["integer","null"],"minimum":1},
        "project_ids": {"type":"null"},
        "confirmation_ready": {"const":true},
        "fields": {"type":"array","maxItems":3,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "body_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "plan_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "one_time_sink_required": {"const":false}
      }
    },
    "identity": {"$ref":"#/$defs/identity"},
    "verified_target": {"$ref":"#/$defs/verified_target"},
    "credential_source": {"type":"string","minLength":1},
    "credential_digest": {"type":"string","minLength":1},
    "skill": {"type":"object"},
    "related_job": {
      "oneOf": [
        {"type":"null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id","status","failure_reason","pipeline_id","runner_id"],
          "properties": {
            "id": {"type":"integer","minimum":1},
            "status": {"type":"string","minLength":1},
            "failure_reason": {"type":["string","null"]},
            "pipeline_id": {"type":["integer","null"],"minimum":1},
            "runner_id": {"type":["integer","null"],"minimum":1}
          }
        }
      ]
    },
    "records": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/runner"}},
    "readback": {"type":"object"},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source","reason"],
        "properties": {"source":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}
      }
    },
    "summary": {
      "type": "object",
      "required": ["record_count","error_count"],
      "properties": {"record_count":{"type":"integer","minimum":0,"maximum":100},"error_count":{"type":"integer","minimum":0}},
      "additionalProperties": false
    },
    "report_files": {"type":"object"}
  },
  "allOf": [
    {
      "if": {"properties":{"status":{"const":"PASS"}},"required":["status"]},
      "then": {
        "required": [
          "operation",
          "phase",
          "mutated",
          "plan",
          "plan_digest",
          "records",
          "readback",
          "related_job",
          "identity",
          "verified_target",
          "credential_source",
          "credential_digest",
          "skill",
          "tested_revision"
        ],
        "properties": {
          "phase": {"const":"READ"},
          "mutated": {"const":false},
          "tested_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"},
          "skill": {"$ref":"#/$defs/verified_skill"},
          "identity": {"$ref":"#/$defs/identity"},
          "verified_target": {"$ref":"#/$defs/verified_target"},
          "errors": {"maxItems":0},
          "readback": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verified","record_count","truncated"],
            "properties": {
              "verified": {"const":true},
              "record_count": {"type":"integer","minimum":0,"maximum":100},
              "truncated": {"type":"boolean"}
            }
          },
          "summary": {"properties":{"error_count":{"const":0}}}
        }
      }
    },
    {
      "if": {"properties":{"status":{"const":"DRY_RUN"}},"required":["status"]},
      "then": {
        "required": ["operation","phase","mutated","records","plan"],
        "properties": {
          "phase": {"const":"OFFLINE_PLAN"},
          "mutated": {"const":false},
          "records": {"maxItems":0},
          "errors": {"maxItems":0},
          "summary": {"properties":{"record_count":{"const":0},"error_count":{"const":0}}}
        }
      }
    },
    {
      "if": {"properties":{"status":{"const":"BLOCKED"}},"required":["status"]},
      "then": {"properties":{"errors":{"minItems":1}}}
    }
  ],
  "$defs": {
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "runner_type",
        "tag_list",
        "status",
        "online",
        "paused",
        "is_shared",
        "access_level",
        "job_execution_status",
        "projects",
        "contacted_at",
        "version",
        "platform",
        "architecture"
      ],
      "properties": {
        "id": {"type":"integer","minimum":1},
        "description": {"type":["string","null"]},
        "runner_type": {"type":"string","minLength":1},
        "tag_list": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "status": {"type":["string","null"]},
        "online": {"type":["boolean","null"]},
        "paused": {"type":["boolean","null"]},
        "is_shared": {"type":["boolean","null"]},
        "access_level": {"type":["string","null"]},
        "job_execution_status": {"type":["string","null"]},
        "projects": {"type":["array","null"],"uniqueItems":true,"items":{"type":"integer","minimum":1}},
        "contacted_at": {"type":["string","null"]},
        "version": {"type":["string","null"]},
        "platform": {"type":["string","null"]},
        "architecture": {"type":["string","null"]}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","username","web_url"],
      "properties": {
        "id": {"type":"integer","minimum":1},
        "username": {"type":"string","minLength":1},
        "web_url": {"type":"string","pattern":"^https://"}
      }
    },
    "verified_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","id","full_path","web_url"],
      "properties": {
        "kind": {"enum":["project","group"]},
        "id": {"type":"integer","minimum":1},
        "full_path": {"type":"string","minLength":1},
        "web_url": {"type":"string","pattern":"^https://"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm","digest","file_count","revision","consuming_project"],
      "properties": {
        "algorithm": {"const":"sha256-tree-v1"},
        "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
        "file_count": {"type":"integer","minimum":1},
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value","source","verified"],
          "properties": {
            "value": {"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},
            "source": {"type":["string","null"],"minLength":1},
            "verified": {"type":"boolean"},
            "detail": {"type":"string","minLength":1}
          }
        },
        "consuming_project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit","source"],
          "properties": {"commit":{"type":["string","null"],"minLength":1},"source":{"type":["string","null"],"minLength":1}}
        }
      }
    },
    "verified_skill": {
      "allOf": [
        {"$ref":"#/$defs/skill"},
        {
          "properties": {
            "revision": {
              "properties": {"value":{"type":"string","pattern":"^[0-9a-f]{40}$"},"verified":{"const":true}}
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
