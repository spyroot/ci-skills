{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/results/gitlab-job-list.schema.json",
  "title": "GitLab job list result",
  "description": "JSON or YAML result from ci-skills/bin/gitlab_job.py list. A live PASS or PARTIAL carries verified GitLab access and bounded job records; an early BLOCKED result carries classified errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "captured_at", "status", "errors", "summary"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "kind": {"const": "gitlab_job"},
    "operation": {"const": "list"},
    "captured_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "DRY_RUN"]},
    "target": {"type": "string", "pattern": "^https://"},
    "target_source": {"type": "string", "minLength": 1},
    "execution_host": {"type": "string", "minLength": 1},
    "tested_revision": {"type": ["string", "null"]},
    "skill": {"type": "object"},
    "report_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "text"],
      "properties": {
        "json": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "status", "pipeline_id", "ref", "search", "name_glob", "limit", "from", "to", "stuck_after"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "status": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["failed", "success", "running", "pending", "canceled", "stuck"]}
        },
        "pipeline_id": {"type": ["integer", "null"], "minimum": 1},
        "ref": {"type": ["string", "null"], "minLength": 1},
        "search": {"type": ["string", "null"], "minLength": 1},
        "name_glob": {"type": ["string", "null"], "minLength": 1},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "from": {"type": ["string", "null"], "format": "date-time"},
        "to": {"type": ["string", "null"], "format": "date-time"},
        "stuck_after": {"type": "integer", "minimum": 1}
      }
    },
    "records": {
      "type": "array",
      "maxItems": 500,
      "items": {"$ref": "#/$defs/job"}
    },
    "truncated": {"type": "boolean"},
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "target", "observed_capability"],
      "properties": {
        "status": {"enum": ["PASS", "BLOCKED", "DRY_RUN"]},
        "identity": {"type": ["object", "null"]},
        "target": {"type": ["object", "null"]},
        "observed_capability": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "collection_probes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "error_count"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0, "maximum": 500},
        "error_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "oneOf": [
    {
      "required": ["operation", "target", "filters", "records", "truncated", "access"],
      "properties": {"operation": {"const": "list"}}
    },
    {
      "not": {"required": ["operation"]},
      "properties": {"status": {"const": "BLOCKED"}, "errors": {"minItems": 1}}
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["PASS", "PARTIAL"]}}, "required": ["status"]},
      "then": {
        "required": ["execution_host", "tested_revision", "skill", "target_source", "access"],
        "properties": {
          "tested_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "skill": {
            "required": ["digest", "file_count", "revision"],
            "properties": {
              "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "file_count": {"type": "integer", "minimum": 1},
              "revision": {
                "type": "object",
                "required": ["value", "source", "verified"],
                "properties": {
                  "value": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  "source": {"type": "string", "minLength": 1},
                  "verified": {"type": "boolean"}
                }
              }
            }
          },
          "access": {
            "required": ["status", "identity", "target", "observed_capability"],
            "properties": {
              "status": {"const": "PASS"},
              "identity": {"$ref": "#/$defs/identity"},
              "target": {"$ref": "#/$defs/project"},
              "observed_capability": {
                "allOf": [
                  {"contains": {"const": "identity_read"}},
                  {"contains": {"const": "target_read"}}
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {"properties": {"errors": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "PARTIAL"}}, "required": ["status"]},
      "then": {"properties": {"errors": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "BLOCKED"}}, "required": ["status"]},
      "then": {"properties": {"errors": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "DRY_RUN"}}, "required": ["status"]},
      "then": {
        "properties": {
          "records": {"maxItems": 0},
          "truncated": {"const": false},
          "access": {"properties": {"status": {"const": "DRY_RUN"}}}
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["id", "username", "web_url"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "username": {"type": "string", "minLength": 1},
        "web_url": {"type": "string", "pattern": "^https://"}
      }
    },
    "project": {
      "type": "object",
      "required": ["kind", "id", "full_path", "web_url"],
      "properties": {
        "kind": {"const": "project"},
        "id": {"type": "integer", "minimum": 1},
        "full_path": {"type": "string", "minLength": 1},
        "web_url": {"type": "string", "pattern": "^https://"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reason"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "stage", "status", "stuck", "failure_reason", "created_at", "started_at", "finished_at", "duration", "runner", "pipeline_id", "ref", "web_url"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "stuck": {"type": "boolean"},
        "failure_reason": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "duration": {"type": ["number", "null"], "minimum": 0},
        "runner": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description"],
              "properties": {
                "id": {"type": "integer", "minimum": 1},
                "description": {"type": ["string", "null"]}
              }
            }
          ]
        },
        "pipeline_id": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "minLength": 1},
        "web_url": {"type": "string", "pattern": "^https://"}
      }
    }
  }
}
