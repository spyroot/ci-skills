{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/blob/main/schemas/smoke-result.schema.json",
  "title": "Required CI smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job",
    "commit",
    "standards_revision",
    "pipeline_id",
    "runner_digest",
    "artifact_digest",
    "smoke_class",
    "status",
    "checks",
    "warnings",
    "skipped_required_tests",
    "remaining_resources",
    "evidence_sanitized"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "standards_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pipeline_id": {"type": "string", "minLength": 1},
    "runner_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "smoke_class": {"enum": ["wiring", "offline-component"]},
    "status": {"enum": ["passed", "failed"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "tools", "entrypoint", "negative_path", "read_back", "cleanup"],
      "properties": {
        "startup": {"enum": ["passed", "failed"]},
        "tools": {"enum": ["passed", "failed"]},
        "entrypoint": {"enum": ["passed", "failed"]},
        "negative_path": {"enum": ["passed", "failed"]},
        "read_back": {"enum": ["passed", "failed"]},
        "cleanup": {"enum": ["passed", "failed"]}
      }
    },
    "warnings": {"type": "integer", "minimum": 0},
    "skipped_required_tests": {"type": "integer", "minimum": 0},
    "remaining_resources": {"type": "array", "items": {"type": "string"}, "maxItems": 0},
    "evidence_sanitized": {"const": true}
  }
}
