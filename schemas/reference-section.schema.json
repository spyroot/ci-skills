{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/reference-section.schema.json",
  "title": "reference_section",
  "description": "One answer of ci-skills/bin/reference.py get REFERENCE ANCHOR: one section's own text, verbatim and bounded, the pin it was read at, and read entries for its subsections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "document",
    "anchor",
    "pinned",
    "text",
    "reference",
    "continuation"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "kind": {
      "const": "reference_section"
    },
    "document": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "anchor": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "tier": {
      "type": "string",
      "pattern": "^(card|part:[a-z0-9-]+)$"
    },
    "pinned": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "maxLength": 8192
    },
    "reference": {
      "type": "array",
      "items": {
        "$ref": "reference-next.schema.json#/$defs/entry"
      }
    },
    "continuation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "error": {
      "$ref": "reference-next.schema.json#/$defs/error"
    }
  }
}
