{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/commands/arguments/bless.schema.json",
  "title": "bless.sh arguments",
  "type": "object",
  "required": ["scope", "dry_run", "format"],
  "properties": {
    "scope": {"enum": ["staged", "all"]},
    "dry_run": {"type": "boolean"},
    "format": {"enum": ["human", "json", "yaml"]},
    "log_format": {"enum": ["text", "json"]},
    "log_level": {"enum": ["debug", "info", "warning", "error"]},
    "log_file": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
