{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/commands/arguments/dev.schema.json",
  "title": "scripts/dev.sh arguments",
  "type": "object",
  "required": ["operation", "mode", "format", "timeout_seconds"],
  "properties": {
    "operation": {"enum": ["install", "toolchain", "conda", "hooks"]},
    "mode": {"enum": ["plan", "apply"]},
    "format": {"enum": ["human", "json", "yaml"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "run_id": {"type": "string"},
    "log_format": {"enum": ["text", "json"]},
    "log_level": {"enum": ["debug", "info", "warning", "error"]},
    "log_file": {"type": "string", "minLength": 1},
    "confirmed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "apply"}}},
      "then": {"properties": {"confirmed": {"const": true}}, "required": ["confirmed"]}
    }
  ],
  "additionalProperties": false
}
