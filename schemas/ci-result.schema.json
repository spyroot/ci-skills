{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/blob/main/schemas/ci-result.schema.json",
  "title": "Required CI job result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job",
    "commit",
    "standards_revision",
    "pipeline_id",
    "runner_digest",
    "artifact_digest",
    "status",
    "warnings",
    "skipped_required_tests",
    "step_results",
    "blocking_reasons",
    "cleanup",
    "evidence_sanitized"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "standards_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pipeline_id": {"type": "string", "minLength": 1},
    "runner_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "status": {"enum": ["passed", "failed"]},
    "warnings": {"type": "integer", "minimum": 0},
    "skipped_required_tests": {"type": "integer", "minimum": 0},
    "step_results": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["success", "failure", "cancelled", "skipped"]}
    },
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "remaining"],
      "properties": {
        "status": {"enum": ["passed", "failed"]},
        "remaining": {"type": "array", "items": {"type": "string"}, "maxItems": 0}
      }
    },
    "evidence_sanitized": {"const": true}
  }
}
