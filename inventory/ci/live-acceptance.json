{
  "$schema": "../../schemas/live-acceptance-policy.schema.json",
  "schemaVersion": "1.0",
  "maxReceiptAgeDays": 30,
  "requiredOperations": [
    {"kind": "access_check", "operation": null, "action": null},
    {"kind": "gitlab_mirror", "operation": "sync", "action": "APPLIED"},
    {"kind": "gitlab_mirror", "operation": "sync", "action": "NO_OP"}
  ],
  "receiptDirectories": [
    "tests/acceptance/receipts",
    "tests/acceptance/runner-tag",
    "tests/acceptance/runner-lifecycle",
    "tests/acceptance/podman-readiness",
    "tests/acceptance/candidate"
  ],
  "historicalDirectory": "tests/acceptance/historical",
  "scheduledCheck": {
    "workflow": ".github/workflows/validate.yml",
    "cron": "0 6 * * 1"
  },
  "rerunProcedure": "README.md#live-acceptance-reruns"
}
