{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/gitlab-agent.schema.json",
  "title": "Normalized GitLab Agent intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "project",
    "project_name",
    "agent_name",
    "run_id",
    "namespace",
    "job_url"
  ],
  "properties": {
    "operation": {
      "enum": [
        "connect",
        "verify",
        "delete"
      ]
    },
    "project": {
      "$ref": "#/$defs/text"
    },
    "project_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_name": {
      "anyOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/run_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "namespace": {
      "anyOf": [
        {
          "$ref": "#/$defs/name"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https?://",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "release_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 53,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "image_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "positive_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$"
    },
    "project_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\s]+(/[^/\\s]+)+$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "kind",
        "name",
        "namespace",
        "uid",
        "state",
        "created"
      ],
      "properties": {
        "api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "uid": {
          "anyOf": [
            {
              "$ref": "#/$defs/uid"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "PRESENT",
            "ABSENT",
            "UNKNOWN"
          ]
        },
        "created": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ClusterRoleBinding"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "name": {
                "pattern": "^[a-z0-9]([-a-z0-9.:]*[a-z0-9])?$"
              }
            }
          },
          "else": {
            "properties": {
              "name": {
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "verify",
              "delete"
            ]
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "run_id": {
            "$ref": "#/$defs/run_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "agent_name": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "verify"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "job_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https?://",
            "format": "uri"
          },
          "agent_name": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "job_url": {
            "type": "null"
          }
        }
      }
    }
  ]
}
