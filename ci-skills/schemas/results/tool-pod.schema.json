{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/results/tool-pod.schema.json",
  "title": "Tool Pod preparation and removal result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "captured_at",
    "target",
    "filters",
    "records",
    "errors",
    "status",
    "summary",
    "operation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "tool_pod"
    },
    "captured_at": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "filters": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "callback"
        ],
        "properties": {
          "callback": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "action": {
            "enum": [
              "APPLIED",
              "NO_OP",
              "VERIFIED"
            ]
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED",
        "PARTIAL",
        "DRY_RUN",
        "PLANNED"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "record_count",
        "error_count"
      ],
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "access": {
      "type": "object"
    },
    "cleanup": {
      "type": "object",
      "required": [
        "status",
        "failures",
        "resources",
        "retained"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "BLOCKED"
          ]
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "callback",
              "reason"
            ],
            "properties": {
              "callback": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "retained": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "skill": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "$ref": "gitlab-runner-tag.schema.json#/$defs/skill"
        }
      ]
    },
    "tested_revision": {
      "$ref": "gitlab-runner-tag.schema.json#/properties/tested_revision"
    },
    "trace_artifact": {
      "type": "string",
      "description": "Caller-selected diagnostic artifact path; read-back results remain in records."
    },
    "plan": {
      "type": "object"
    },
    "pod": {
      "type": "object",
      "required": [
        "namespace",
        "name",
        "uid",
        "container"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "node_name": {
          "type": "string",
          "minLength": 1,
          "description": "Actual spec.nodeName observed from Kubernetes; absent in legacy records."
        }
      }
    },
    "run_id": {
      "type": "string"
    },
    "target_source": {
      "type": "string"
    },
    "target_file": {
      "type": "string"
    },
    "readback": {
      "type": "object",
      "description": "Actual Pod, tool, retention or removal observations."
    }
  }
}
