{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/spyroot/ci-skills/schemas/results/olm-operator.schema.json",
  "title": "OLM operator result",
  "description": "Versioned envelope for ocp_operator.py plan and operation evidence (CI16).",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status",
    "captured_at",
    "errors",
    "summary"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "olm_operator"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "PARTIAL",
        "BLOCKED",
        "DRY_RUN",
        "PLANNED",
        "NO_OP",
        "APPLIED"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "install",
        "apply",
        "remove"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string"
    },
    "target_file": {
      "type": "string"
    },
    "target_source": {
      "type": "string"
    },
    "tested_revision": {
      "type": "string"
    },
    "plan": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "package": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "catalog_source": {
          "type": "string"
        },
        "catalog_source_namespace": {
          "type": "string"
        },
        "install_mode": {
          "type": "string"
        },
        "approval": {
          "type": "string",
          "enum": [
            "Automatic",
            "Manual"
          ]
        },
        "starting_csv": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "installed_csv": {
          "type": [
            "string",
            "null"
          ]
        },
        "csv_phase": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confirmable": {
      "type": "boolean"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "need",
          "evidence",
          "supply"
        ],
        "additionalProperties": true,
        "properties": {
          "need": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "supply": {
            "type": "string"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": true
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "reason"
        ],
        "additionalProperties": true,
        "properties": {
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "record_count",
        "error_count"
      ],
      "additionalProperties": true,
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": true
    },
    "skill": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
