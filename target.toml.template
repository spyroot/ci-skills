# Target template — copy, fill in, and keep the copy OUT of this repository.
#
#     mkdir -p ~/.ci-skills
#     cp target.toml.template ~/.ci-skills/target.toml
#     $EDITOR ~/.ci-skills/target.toml
#
# Or per project, for a repository that owns its own cluster:
#
#     mkdir -p .ci-skills && cp target.toml.template .ci-skills/target.toml
#
# Every command then needs no --target argument at all. Override the location
# with --target PATH or CI_SKILLS_TARGET if you keep it elsewhere.
#
# This file is NONSECRET: it names authorities and points at credential files.
# It must contain no token, password or key — the parser rejects those fields.
# The allowed keys are declared in ci-skills/lib/python/core/endpoints.py:
# per authority, an endpoint and its access. gates/gate-ci-skills-endpoints.py
# refuses any other key, here and in every documented example.
#
# Two rules about where the filled-in copy lives, both learned the hard way:
#
#   1. Do not commit it. The paths in it are true on one machine only.
#   2. Do not let anything that runs elsewhere reference it. A pipeline that
#      points at a path under someone's home directory fails the moment it runs
#      on a runner, and the failure looks like a credential problem rather than
#      a wiring mistake. CI declares its own target or project binding.
#
# This template shows all three authorities for access_check.py. A Kubernetes
# command needs only [kubernetes]; a GitLab job needs only [gitlab]. Remove
# unused sections when making a single-authority target. Nothing here grants
# access; each command checks the authority it uses.

[github]
# The exact host and repository. Enterprise Server hosts work too.
host = "github.com"
repository = "owner/repository"

# Optional: a private token file, if you do not want the `gh` credential store
# used. Absolute or relative to this target file; keep it outside this
# repository and the installed skill.
# token_file = "/home/operator/.ci-skills/credentials/github.token"

# Required for `access_check.py --publication`: the status checks that branch
# protection must require. Compared by exact equality, and a declared check
# that protection does not require blocks. Omit the field and publication mode
# refuses rather than accepting whatever it finds.
# required_checks = ["validate"]

[gitlab]
# The exact origin. A job URL on any other host is refused.
url = "https://gitlab.example.com"

# For GitLab-only access and actions, set the exact project or group here.
# Use one selector at a time for `gitlab_access.py check`.
# The declared --project / --group flags override that choice for one run.
# No repository remote or glab profile supplies a fallback target.
# project = "group/project"
# group = "group"
# runner_id = 123

# Optional: a private token file instead of the `glab` credential store.
# Relative paths resolve beside this target file.
# The full diagnostics access check needs an instance administrator identity.
# The GitLab-only check proves identity and target read access; an action's
# apply and read-back establish whether that action is authorized.
# token_file = "/home/operator/.ci-skills/credentials/gitlab.token"

[kubernetes]
# The context name and the API server it must resolve to. The server is
# compared against the kubeconfig, so a context that silently points somewhere
# else is refused rather than read.
context = "admin-context"
server = "https://api.cluster.example.com:6443"

# How the credential is found. Declare ONE of the two forms below, or omit
# both to use KUBECONFIG, then ~/.kube/config. An explicit project binding
# can also select the kubeconfig. Context and server are verified either way.

# One file:
# kubeconfig = "/home/operator/.kube/config"

# Or the whole search path, in kubectl's own order. Use this when the context
# and the credential live in separate files — for example a CA-verified overlay
# plus the file holding the token. It needs no environment variable.
# kubeconfigs = [
#   "/home/operator/.ci-skills/credentials/kubeconfig",
#   "/home/operator/.kube/config",
# ]

# Optional node diagnostics. Declare only the route you use. Each route names
# an EXISTING Pod on one node; the commands never create a privileged debug Pod.
# The selector must match exactly one Running Pod on `node` in its namespace.
# [kubernetes.node_diagnostics]
# node = "worker.example.com"
#
# [kubernetes.node_diagnostics.cilium]
# namespace = "cilium"
# selector = "app.kubernetes.io/name=cilium-agent"
# container = "cilium-agent"
#
# [kubernetes.node_diagnostics.journal]
# namespace = "node-diagnostics"
# selector = "app.kubernetes.io/name=journal-reader"
# container = "journal-reader"
# directory = "/host-journal"
# host_path = "/var/log/journal"
# The selected Pod must mount host_path at directory in this container and
# provide journalctl. A missing or ambiguous Pod/mount produces BLOCKED.
